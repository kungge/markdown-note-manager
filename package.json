{
  "name": "markdown-note-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"pnpm --filter @note-manager/server dev\" \"pnpm --filter @note-manager/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "start": "pnpm --filter @note-manager/server start"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  }
}

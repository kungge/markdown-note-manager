# Optional absolute path opened at startup. Leave unset to choose a workspace from the UI.
NOTE_MANAGER_WORKSPACE=/Users/your-name/notes/NoteHub

# Comma-separated workspace-relative paths hidden from the UI and search.
# UI hiding is not encryption or an operating-system security boundary.
# Dot-directories such as .git and .workbuddy are always hidden.
NOTE_MANAGER_HIDDEN_PATHS=30-finance,60-work,80-resources/accounts,88-money

# Optional comma- or newline-separated Git-style ignore patterns.
# Supports files, directories, ** wildcards, and ! negation.
NOTE_MANAGER_IGNORE_PATTERNS=archive/**,**/*.draft.md,!archive/keep.md

# The local service is loopback-only by default.
NOTE_MANAGER_HOST=127.0.0.1
NOTE_MANAGER_PORT=43110

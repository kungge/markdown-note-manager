[Unit]
Description=Markdown Note Manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notehub
Group=notehub
WorkingDirectory=/opt/markdown-note-manager/current
EnvironmentFile=/etc/markdown-note-manager/notehub.env
ExecStart=/usr/bin/node apps/server/dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/markdown-note-manager
RuntimeDirectory=markdown-note-manager
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
